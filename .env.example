# Placement Copilot Environment Variables Example

# Database Connection
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/placement_copilot

# Model Service URL
MODEL_SERVICE_URL=http://localhost:8001

# Adzuna configuration (Optional, for live Adzuna fallback)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=your_serpapi_key_here
UNSTOP_API_KEY=your_unstop_api_key_here

# Gmail Tracker Agent OAuth Credentials
# Note: Place credentials.json in the project root directory
